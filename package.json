{
  "name": "petmatch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install": "npm install --prefix backend && npm install --prefix frontend --include=dev",
    "start": "npm run start --prefix backend",
    "dev": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "test:loading-states": "node scripts/test-loading-states.mjs",
    "test:forms": "node scripts/test-forms.mjs",
    "db:generate-sql": "node scripts/json-to-postgres.mjs",
    "heroku-postbuild": "npm run build --prefix frontend && node scripts/sync-frontend.js"
  },
  "engines": {
    "node": "18.x"
  }
}
